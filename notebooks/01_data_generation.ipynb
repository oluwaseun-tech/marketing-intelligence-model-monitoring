{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNGnefwXr6EV7Jh39OOMvDM"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Ui1faUtee2E9","outputId":"f2ce3573-7f6c-4124-ca0f-d5a46d173bd2"},"outputs":[],"source":["!pip -q install duckdb\n","\n","import pandas as pd\n","import numpy as np\n","import duckdb\n","import matplotlib.pyplot as plt\n","\n","from pathlib import Path\n","\n","# Reproducibility\n","np.random.seed(42)\n","\n","print(\"Libraries loaded successfully.\")"]},{"cell_type":"code","source":["from google.colab import drive\n","\n","drive.mount('/content/drive')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RtKEfCvkfBw6","outputId":"a4a5c346-8c77-4a0e-82fb-dd47c3f23159"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["PROJECT_PATH = Path(\n","    \"/content/drive/MyDrive/\"\n","    \"Marketing_Intelligence_Model_Monitoring\"\n",")\n","\n","folders = [\n","    \"data/raw\",\n","    \"data/processed\",\n","    \"data/outputs\",\n","    \"notebooks\",\n","    \"sql\",\n","    \"reports\",\n","    \"dashboard\",\n","    \"src\",\n","    \"tests\"\n","]\n","\n","for folder in folders:\n","    (PROJECT_PATH / folder).mkdir(\n","        parents=True,\n","        exist_ok=True\n","    )\n","\n","print(\"Project structure created successfully.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"anS5MIVwfKAn","outputId":"fba063d5-ba09-4586-905d-c8acfa3206ad"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Define the observation period\n","dates = pd.date_range(\n","    start=\"2024-01-01\",\n","    periods=104,\n","    freq=\"W-MON\"\n",")\n","\n","channels = [\"Google Ads\", \"Meta Ads\", \"TikTok Ads\"]\n","\n","# Channel-specific assumptions\n","channel_parameters = {\n","    \"Google Ads\": {\n","        \"base_spend\": 12000,\n","        \"ctr\": 0.035,\n","        \"cvr\": 0.045,\n","        \"alpha\": 0.65,\n","        \"half_saturation\": 12000,\n","        \"decay\": 0.45\n","    },\n","    \"Meta Ads\": {\n","        \"base_spend\": 9000,\n","        \"ctr\": 0.025,\n","        \"cvr\": 0.035,\n","        \"alpha\": 0.60,\n","        \"half_saturation\": 10000,\n","        \"decay\": 0.55\n","    },\n","    \"TikTok Ads\": {\n","        \"base_spend\": 6000,\n","        \"ctr\": 0.018,\n","        \"cvr\": 0.025,\n","        \"alpha\": 0.55,\n","        \"half_saturation\": 8000,\n","        \"decay\": 0.60\n","    }\n","}\n","\n","# Seasonal and promotional factors\n","week_number = np.arange(len(dates))\n","\n","seasonality = (\n","    1\n","    + 0.15 * np.sin(2 * np.pi * week_number / 52)\n",")\n","\n","promotion_active = (\n","    (week_number % 26 >= 20) &\n","    (week_number % 26 <= 22)\n"",")\n","\n","discount_rate = np.where(\n","    promotion_active,\n","    0.15,\n","    0.02\n",")\n","\n","# Generate advertising records\n","ad_records = []\n","\n","for channel in channels:\n","\n","    params = channel_parameters[channel]\n","\n","    spend = (\n","        params[\"base_spend\"]\n","        * (1 + 0.20 * np.sin(\n","            2 * np.pi * week_number / 26\n","        ))\n","        * np.random.normal(1, 0.08, len(dates))\n","    )\n","\n","    spend = np.maximum(spend, 1000)\n","\n","    impressions = (\n","        spend * np.random.uniform(7, 12, len(dates))\n","    ).astype(int)\n","\n","    clicks = (\n","        impressions * params[\"ctr\"]\n","        * np.random.normal(1, 0.05, len(dates))\n","    ).astype(int)\n","\n","    conversions = (\n","        clicks * params[\"cvr\"]\n","        * np.random.normal(1, 0.07, len(dates))\n","    ).astype(int)\n","\n","    # Advertising carryover: adstock\n","    adstock = np.zeros(len(dates))\n","\n","    for i in range(len(dates)):\n","        if i == 0:\n","            adstock[i] = spend[i]\n","        else:\n","            adstock[i] = (\n","                spend[i]\n","                + params[\"decay\"] * adstock[i-1]\n","            )\n","\n","    # Hill saturation transformation\n","    contribution = (\n","        adstocki ** 1.5\n","        / (\n","            adstocki ** 1.5\n","            + params[\"half_saturation\"] ** 1.5\n","        )\n","    )\n","\n","    contribution = contribution * 35000\n","\n","    for i, date in enumerate(dates):\n","\n","        ad_records.append({\n","            \"date\": date,\n","            \"channel\": channel,\n","            \"campaign_id\": f\"CMP_{channels.index(channel)+1}\",\n","            \"campaign_name\": f\"{channel} Campaign\",\n","            \"spend\": round(spend[i], 2),\n","            \"impressions\": impressions[i],\n","            \"clicks\": clicks[i],\n","            \"conversions\": conversions[i],\n","            \"adstock\": round(adstock[i], 2),\n","            \"channel_effect\": round(contribution[i], 2)\n","        })\n","\n","advertising_df = pd.DataFrame(ad_records)\n","\n","# Generate business-level revenue\n","total_marketing_effect = (\n","    advertising_df\n","    .groupby(\"date\")[\"channel_effect\"]\n","    .sum()\n","    .reindex(dates)\n","    .values\n",")\n","\n","base_revenue = 30000\n","\n","revenue = (\n","    base_revenue\n","    + total_marketing_effect\n","    + 12000 * (seasonality - 1)\n","    + 10000 * promotion_active\n","    + np.random.normal(0, 4500, len(dates))\n",")\n","\n","events = np.maximum(revenue, 10000)\n","\n","orders = np.maximum(\n","    (revenue / 100).astype(int),\n","    1\n",")\n","\n","new_customers = np.maximum(\n","    (orders * np.random.uniform(0.45, 0.65, len(dates))).astype(int),\n","    1 \n",")\n","\n","sales_df = pd.DataFrame({\n","    \"date\": dates,\n","    \"orders\": orders,\n","    \"new_customers": new_customers,\n","    \"revenue\": np.round(revenue, 2),\n","    \"average_order_value\": np.round(\n","        revenue / orders, 2\n","    )\n","})\n","\n","promotions_df = pd.DataFrame({\n","    \"date\": dates,\n","    \"promotion_active\": promotion_active.astype(int),\n","    \"discount_rate\": discount_rate,\n","    \"seasonality_index\": np.round(seasonality, 3)\n","})\n","\n","print(\"Advertising records:\", len(advertising_df))\n","print(\"Sales records:\", len(sales_df))\n","print(\"Promotion records:\", len(promotions_df))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2-Fcr3ZOfQGn","outputId":"a5169340-2ea4-4575-b847-63d837a2e8b0"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Preserve a clean reference copy for testing\n","advertising_clean_reference = advertising_df.copy()\n","\n","# Create a raw dataset with intentional issues\n","advertising_raw
 = advertising_df.copy()\n","\n","# Issue 1: Missing advertising spend\n","advertising_raw.loc[\n","    10, \"spend\"\n","] = np.nan\n","\n","advertising_raw.loc[\n","    85, \"spend\"\n","] = np.nan\n","\n","# Issue 2: Duplicate record\n","duplicate_record = advertising_raw.iloc[[25]].copy()\n","\n","advertising_raw = pd.concat(\n","    [advertising_raw, duplicate_record],\n","    ignore_index=True\n",")\n","\n","# Issue 3: Incorrect campaign labels\n","advertising_raw.loc[\n","    40, \"campaign_name\"\n","] = \"GoogleAds Campaign\"\n","\n","advertising_raw.loc[\n","    100, \"campaign_name\"\n","] = \"Meta Campaign\"\n","\n","# Issue 4: Negative advertising spend\n","advertising_raw.loc[\n","    150, \"spend\"\n","] = -500\n","\n","# Issue 5: Missing campaign identifier\n","advertising_raw.loc[\n","    200, \"campaign_id\"\n","] = None\n","\n","print(\"Raw advertising dataset created.\")\n","print(\"Records:\", len(advertising_raw))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Sq-ZqTIyfZmU","outputId":"6a9961c0-a4a4-486f-8ce9-67dfb5176bd3"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Save raw advertising data\n","advertising_raw.to_csv(\n","    PROJECT_PATH / \"data/raw/advertising_performance.csv\",\n","    index=False\n",")\n","\n","# Save clean reference data for simulation validation\n","advertising_clean_reference.to_csv(\n","    PROJECT_PATH / \"data/raw/advertising_clean_reference.csv\",\n","    index=False\n",")\n","\n","# Save sales data\n","sales_df.to_csv(\n","    PROJECT_PATH / \"data/raw/sales_performance.csv\",\n","    index=False\n",")\n","\n","# Save promotion data\n","promotions_df.to_csv(\n","    PROJECT_PATH / \"data/raw/promotions.csv\",\n","    index=False\n",")\n","\n","print(\"All datasets saved successfully.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"97cUSyRzffIE","outputId":"35d69fc9-f26f-41ee-bfc2-fe1eb491ecf2"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["print(\"ADVERTISING DATA\")\n","display(advertising_raw.head())\n","\n","print(\"\\nSALES DATA\")\n","display(sales_df.head())\n","\n","print(\"\\nPROMOTIONS DATA\")\n","display(promotions_df.head())\n","\n","print(\"\\nDATASET DIMENSIONS\")\n","print(\"Advertising:\", advertising_raw.shape)\n","print(\"Sales:\", sales_df.shape)\n","print(\"Promotions:\", promotions_df.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":864},"id":"nBpmiKUIfj7o","outputId":"300b92e3-14f9-4209-a6ed-f47dcc435ce3"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Aggregate advertising spend by channel\n","channel_spend = (\n","    advertising_clean_reference\n","    .groupby(\"channel\")[\"spend\"]\n","    .sum()\n","    .sort_values(ascending=False)\n",")\n","\n","print(\"Total advertising spend by channel:\")\n","display(channel_spend)\n","\n","# Total business revenue\n","print(\n","    \"Total revenue:\",\n","    round(sales_df[\"revenue\"].sum(), 2)\n",")\n","\n","# Weekly revenue trend\n","plt.figure(figsize=(14, 5))\n","\n","plt.plot(\n","    sales_df[\"date\"],\n","    sales_df[\"revenue\"],\n","    label=\"Weekly Revenue\"\n",")\n","\n","plt.title(\"Weekly E-commerce Revenue\")\n","plt.xlabel(\"Date\")\n","plt.ylabel(\"Revenue ($)\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":496},"id":"7Aj8eHiUfsIB","outputId":"849d3dac-a290-4270-d303-58845297df2d"},"execution_count":null,"outputs":[]}]}